# Copy to .env and fill in. Never put real secrets in this file; it is committed.

# AI providers: add a key for each provider you want. Models from every configured provider
# appear in the model picker. LangChain is used for writing; each provider's own web search
# tool is used for research and QA reference checks.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# The one model the whole app uses. Set OPENAI_MODEL, or DEFAULT_MODEL as "provider:model" (it wins if both are set).
OPENAI_MODEL="gpt-6-luna"
# DEFAULT_MODEL="openai:gpt-6-luna"
GEMINI_MODEL="gemini-3.8-flash"
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Optional timeouts in milliseconds
STEP_TIMEOUT_MS=120000
RESEARCH_TIMEOUT_MS=150000
QA_TIMEOUT_MS=180000

# Supabase project (Project Settings > API Keys). The anon key is safe in the browser; RLS protects the data.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Postgres connection string, used only by `npm run db:migrate`.
# If the direct host fails (it is IPv6-only), use the Session pooler string from Supabase > Connect.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# Optional: NCBI E-utilities key for PubMed look-ups (raises the limit from 3 to 10 requests per second).
# Free from https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=""

# Optional: cheaper model for web research only (searches, approved-site checks, PubMed selection).
# Writing, the sample build and the checks stay on OPENAI_MODEL. Leave empty to research with OPENAI_MODEL.
RESEARCH_MODEL="openai:gpt-5.4-mini"

# Optional: how much page text each web search returns (low, medium or high). Search text is billed
# as input tokens and is most of the research cost; "low" is the default.
SEARCH_CONTEXT_SIZE="low"
