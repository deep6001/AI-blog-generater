# Copy to .env and fill in. Never put real secrets in this file; it is committed.

# AI providers: add a key for each provider you want. Models from every configured provider
# appear in the model picker. LangChain is used for writing; each provider's own web search
# tool is used for research and QA reference checks.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Optional: default model for projects that don't choose one ("provider:model")
DEFAULT_MODEL="openai:gpt-5"
# Optional per-provider defaults, also shown if the provider's model list can't be fetched
OPENAI_MODEL="gpt-5"
GEMINI_MODEL="gemini-3.8-flash"
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Optional timeouts in milliseconds
STEP_TIMEOUT_MS=120000
RESEARCH_TIMEOUT_MS=150000
QA_TIMEOUT_MS=180000

# Supabase project (Project Settings > API Keys). The anon key is safe in the browser; RLS protects the data.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Postgres connection string, used only by `npm run db:migrate`.
# If the direct host fails (it is IPv6-only), use the Session pooler string from Supabase > Connect.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"
